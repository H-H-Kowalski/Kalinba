<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">    };

    public static getInstance(): SceneManager {
        return SceneManager.instance;
    }

    start() {
        SceneManager.instance = this;
    }

    /**
     * 加载首页场景
     */
    loadHomeScene() {
        console.log('加载首页场景');
        director.loadScene(SceneManager.SCENE_NAMES.HOME);
    }

    /**
     * 加载游戏场景
     */
    loadGameScene() {
        console.log('加载游戏场景');
        director.loadScene(SceneManager.SCENE_NAMES.GAME);
    }

    /** 设置页场景（与 playscene 分离） */
    loadSettingsScene(returnTo: SettingsReturnTarget = 'home') {
        SceneManager.prepareSettingsReturnTarget(returnTo);
        director.loadScene(SceneManager.SCENE_NAMES.SETTINGS, (err) =&gt; {
            if (!err) return;
            console.error('[SceneManager] 加载 settings 失败(主名):', SceneManager.SCENE_NAMES.SETTINGS, err);
            // 兼容历史命名，避免拼写差异导致按钮点击无效
            director.loadScene('settingsscene', (err2) =&gt; {
                if (err2) {
                    console.error('[SceneManager] 加载 settings 失败(兼容名): settingsscene', err2);
                }
            });
        });
    }

    /**
     * 重新加载当前场景
     */
    reloadCurrentScene() {
        const currentScene = director.getScene();
        if (currentScene) {
            director.loadScene(currentScene.name);
        }
    }</pre>
