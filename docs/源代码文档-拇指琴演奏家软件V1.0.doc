    return false;
}

// ===== manager/FontSettingsStore.ts =====

import { sys } from 'cc';
import { clampFontIndex } from './FontsCatalog';

const KEY = 'kalinba_font_settings_v1';

export interface FontSettingsSnapshot {
    /** 对应 FontsCatalog.FONTS_CATALOG 下标 */
    fontIndex: number;
}

export class FontSettingsStore {
    static defaultSnapshot(): FontSettingsSnapshot {
        return { fontIndex: 0 };
    }

    static load(): FontSettingsSnapshot {
        try {
            const raw = sys.localStorage.getItem(KEY);
            if (!raw) return this.defaultSnapshot();
            const o = JSON.parse(raw) as Partial&lt;FontSettingsSnapshot&gt;;
            const d = this.defaultSnapshot();
            return {
                fontIndex: clampFontIndex(typeof o.fontIndex === 'number' ? o.fontIndex : d.fontIndex),
            };
        } catch {
            return this.defaultSnapshot();
        }
    }

    static save(partial: Partial&lt;FontSettingsSnapshot&gt;): void {
        const cur = this.load();
        const next: FontSettingsSnapshot = { ...cur, ...partial };
        next.fontIndex = clampFontIndex(next.fontIndex);
        try {
            sys.localStorage.setItem(KEY, JSON.stringify(next));
        } catch {
            // ignore
        }
    }
}

// ===== manager/HapticFeedback.ts =====

/**</pre>
<hr style="border:none; border-top:1px solid #ccc; margin:16px 0;">
<p style="font-size:11pt; font-weight:bold; margin:20px 0 6px 0; page-break-before:auto;"><b>拇指琴演奏家软件V1.0　　第 5 页</b></p>
<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;"> * 轻触震动：微信小游戏 wx.vibrateShort。
 * （已注释）浏览器 Vibration API。
 * https://developers.weixin.qq.com/minigame/dev/api/device/vibrate/wx.vibrateShort.html
 */

import { getWx } from './WeChatNative';

/** 全局节流：双指同时按会触发两次 vibrateShort，真机马达叠在一起容易发涩、像被「阻碍」 */
let lastKeyVibrateAtMs = 0;
const KEY_VIBRATE_MIN_INTERVAL_MS = 45;

function nowMs(): number {
    return typeof performance !== 'undefined' &amp;&amp; typeof performance.now === 'function'
        ? performance.now()
        : Date.now();
}

/** 琴键等短促反馈，尽量轻；多键同时按只震一次（见 KEY_VIBRATE_MIN_INTERVAL_MS） */
export function vibrateKeyTap(): void {
    const t = nowMs();
    if (t - lastKeyVibrateAtMs &lt; KEY_VIBRATE_MIN_INTERVAL_MS) {
        return;
    }
    lastKeyVibrateAtMs = t;

    const wxApi = getWx() as { vibrateShort?: (o?: { type?: 'heavy' | 'medium' | 'light' }) =&gt; void } | undefined;
    if (wxApi &amp;&amp; typeof wxApi.vibrateShort === 'function') {
        try {
            wxApi.vibrateShort({ type: 'light' });
        } catch {
            try {
                wxApi.vibrateShort();
            } catch {
                // ignore
            }
        }
        return;
    }
    /* 微信小游戏发布：无 navigator.vibrate 回退
    try {
        if (typeof navigator !== 'undefined' &amp;&amp; typeof navigator.vibrate === 'function') {
            navigator.vibrate(12);
        }
    } catch {
        // ignore
    }
    */
}

// ===== manager/PerformancePlayer.ts =====</pre>
