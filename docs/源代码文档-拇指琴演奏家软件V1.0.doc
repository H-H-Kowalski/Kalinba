// ===== manager/PerformanceTypes.ts =====

export const PERFORMANCE_MAX_DURATION_MS = 180000; // 3 minutes
export const PERFORMANCE_MAX_EVENTS = 6000;
export const PERFORMANCE_MAX_ENCODED_SIZE = 128 * 1024;

export interface PerformanceEvent {
    t: number; // ms from recording start
    k: number; // key index
}

export interface PerformanceRecord {
    title?: string;
    stylePreset: number;
    durationMs: number;
    events: PerformanceEvent[];
    appVersion: string;
}

export interface PerformanceSharePayload {
    recordId: string;
}

// ===== manager/WeChatNative.ts =====

/**
 * 微信小游戏全局 wx：真机上可能挂在 GameGlobal，仅 typeof wx 会漏判。
 */
export function getWx(): Record&lt;string, unknown&gt; | undefined {
    const g = globalThis as unknown as { wx?: Record&lt;string, unknown&gt;; GameGlobal?: { wx?: Record&lt;string, unknown&gt; } };
    return g.wx ?? g.GameGlobal?.wx;
}

// ===== manager/KalimbaAudioDebug.ts =====

/**
 * 弹琴 / WebAudio 排查日志总开关。发布前可改为 false 或删掉相关 import。
 */
export const KALIMBA_AUDIO_DEBUG = true;

export function kalimbaAudioLog(scope: string, ...args: unknown[]) {
    if (!KALIMBA_AUDIO_DEBUG) return;
    console.log(`[KalimbaAudio:${scope}]`, ...args);
}

export function kalimbaAudioWarn(scope: string, ...args: unknown[]) {
    if (!KALIMBA_AUDIO_DEBUG) return;
    console.warn(`[KalimbaAudio:${scope}]`, ...args);
}</pre>
