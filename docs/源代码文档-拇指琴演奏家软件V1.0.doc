                    height?: number;
                    naturalWidth?: number;
                    naturalHeight?: number;
                    videoWidth?: number;
                    videoHeight?: number;
                };
            };
        };
        const native = anyTex.image?._nativeAsset;
        const w = Math.floor(
            anyTex.__srcW
            ?? anyTex.width
            ?? anyTex.image?.width
            ?? native?.naturalWidth
            ?? native?.videoWidth
            ?? native?.width
            ?? 0,
        );
        const h = Math.floor(
            anyTex.__srcH</pre>
