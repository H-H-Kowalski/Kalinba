<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">
// ===== manager/SheetRuntimeStore.ts =====

import { sys } from 'cc';

const KEY = 'kalinba_sheet_runtime_v1';

/** 跨场景记录当前是否为「单张长图纵向滚动」模式（由 SheetMusicBackground 写入，设置页读取） */
export class SheetRuntimeStore {
    static setLongImageActive(active: boolean): void {
        try {
            sys.localStorage.setItem(KEY, JSON.stringify({ longImageActive: active }));
        } catch {
            // ignore
        }
    }

    static isLongImageActive(): boolean {
        try {
            const raw = sys.localStorage.getItem(KEY);
            if (!raw) return false;
            const o = JSON.parse(raw) as { longImageActive?: boolean };
            return o.longImageActive === true;
        } catch {
            return false;
        }
    }
}

// ===== manager/FontsCatalog.ts =====

/**
 * 字体目录：当前不打包任何 TTF（assets/fonts 为空），仅提供「系统字体」。
 * 若日后恢复嵌入字体，需在此增加条目并使 uuid 与 .ttf.meta 一致。
 */
export interface FontCatalogEntry {
    /** 用于调试/扩展 */
    id: string;
    displayName: string;
    /** null 表示使用系统默认字体（不加载 TTF） */
    uuid: string | null;
}

export const FONTS_CATALOG: FontCatalogEntry[] = [{ id: 'system', displayName: '系统字体', uuid: null }];

export function getFontCount(): number {
    return FONTS_CATALOG.length;
}

export function clampFontIndex(i: number): number {</pre>
<hr style="border:none; border-top:1px solid #ccc; margin:16px 0;">
<p style="font-size:11pt; font-weight:bold; margin:20px 0 6px 0; page-break-before:auto;"><b>拇指琴演奏家软件V1.0　　第 3 页</b></p>
<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">    const n = FONTS_CATALOG.length;
    if (n &lt;= 0) return 0;
    return Math.max(0, Math.min(n - 1, Math.floor(i)));
}

export function getFontUuid(index: number): string | null {
    const e = FONTS_CATALOG[clampFontIndex(index)];
    return e?.uuid ?? null;
}

/** 当前项是否为「系统字体」（不加载资源） */
export function isSystemFontIndex(index: number): boolean {
    return FONTS_CATALOG[clampFontIndex(index)]?.id === 'system';
}

// ===== manager/ClipboardHelper.ts =====

/**
 * 复制到剪贴板：微信小游戏用 wx.setClipboardData。
 * （已注释）浏览器 Clipboard API，仅 Web 预览用。
 */

import { getWx } from './WeChatNative';

export async function copyTextToClipboard(text: string): Promise&lt;boolean&gt; {
    const wxApi = getWx() as {
        setClipboardData?: (options: {
            data: string;
            success?: () =&gt; void;
            fail?: (err: unknown) =&gt; void;
        }) =&gt; void;
    } | undefined;
    if (wxApi &amp;&amp; typeof wxApi.setClipboardData === 'function') {
        return await new Promise((resolve) =&gt; {
            wxApi.setClipboardData!({
                data: text,
                success: () =&gt; resolve(true),
                fail: () =&gt; resolve(false),
            });
        });
    }
    /* 微信小游戏发布：无 Clipboard API 回退
    try {
        if (typeof navigator !== 'undefined' &amp;&amp; navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
            return true;
        }
    } catch {
        // ignore
    }</pre>
