<p style="font-size:11pt; font-weight:bold; margin:20px 0 6px 0; page-break-before:auto;"><b>拇指琴演奏家软件V1.0　　第 18 页</b></p>
<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">
    /**
     * 获取当前场景名称
     */
    getCurrentSceneName(): string {
        const currentScene = director.getScene();
        return currentScene ? currentScene.name : '';
    }

    /**
     * 检查是否在指定场景
     */
    isInScene(sceneName: string): boolean {
        return this.getCurrentSceneName() === sceneName;
    }

    /**
     * 预加载场景
     */
    preloadScene(sceneName: string, callback?: Function) {
        director.preloadScene(sceneName, (err, scene) =&gt; {
            if (err) {
                console.error(`预加载场景失败: ${sceneName}`, err);
            } else {
                console.log(`预加载场景成功: ${sceneName}`);
            }
            if (callback) callback(err, scene);
        });
    }

    /**
     * 预加载所有场景
     */
    preloadAllScenes() {
        const sceneNames = Object.values(SceneManager.SCENE_NAMES) as string[];
        sceneNames.forEach(sceneName =&gt; {
            this.preloadScene(sceneName);
        });
    }

    onDestroy() {
        SceneManager.instance = null;
    }
}

