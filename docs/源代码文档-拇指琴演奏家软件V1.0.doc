<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">            useSynth: true,
