<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">            if (eb.placeholderLabel) applyToLabel(eb.placeholderLabel, font);
        }
        for (let i = n.children.length - 1; i &gt;= 0; i--) {
            stack.push(n.children[i]);
        }
    }
}

/** 按当前存档字体应用到整棵 UI 子树（异步加载字体资源） */
export async function applySavedFontToSubtree(root: Node): Promise&lt;void&gt; {
    // 当前版本已不支持运行时换字体：保留 API 兼容调用点，但不再改动任何 Label。
    void root;
    return;
}

