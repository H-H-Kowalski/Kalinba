    }
}

// ===== manager/PerformanceCloudService.ts =====

import { getWx } from './WeChatNative';
import { PERFORMANCE_MAX_DURATION_MS, PERFORMANCE_MAX_ENCODED_SIZE, PERFORMANCE_MAX_EVENTS, PerformanceSharePayload, type PerformanceRecord } from './PerformanceTypes';
import { PerformanceRecorder } from './PerformanceRecorder';

type CallResult&lt;T&gt; = {
    result?: T;
};

type CreateResult = PerformanceSharePayload;

type GetResult = {
    record: PerformanceRecord;
};

function callWxCloudFunction&lt;T&gt;(name: string, data: Record&lt;string, unknown&gt;): Promise&lt;T&gt; {
    const wxApi = getWx() as {
        cloud?: {
            callFunction?: (arg: { name: string; data: Record&lt;string, unknown&gt; }) =&gt; Promise&lt;CallResult&lt;T&gt;&gt;;
        };
    } | undefined;
    if (!wxApi?.cloud?.callFunction) {
        return Promise.reject(new Error('wx.cloud.callFunction is unavailable'));
    }
    return wxApi.cloud.callFunction({ name, data }).then((res) =&gt; {
        if (!res?.result) throw new Error('empty cloud result');
        return res.result;
    });
}

export class PerformanceCloudService {
    static async createRecord(record: PerformanceRecord): Promise&lt;string&gt; {
        const err = PerformanceRecorder.validate(record);
        if (err) throw new Error(err);
        if (record.durationMs &gt; PERFORMANCE_MAX_DURATION_MS) throw new Error('duration out of range');
        if (record.events.length &gt; PERFORMANCE_MAX_EVENTS) throw new Error('event count exceeds limit');

        const encoded = PerformanceRecorder.encode(record);
        if (encoded.length &gt; PERFORMANCE_MAX_ENCODED_SIZE) {
            throw new Error('encoded payload too large');
        }
        const result = await callWxCloudFunction&lt;CreateResult&gt;('createPerformanceRecord', {
            durationMs: record.durationMs,
            stylePreset: record.stylePreset,
            title: record.title ?? '',</pre>
<hr style="border:none; border-top:1px solid #ccc; margin:16px 0;">
<p style="font-size:11pt; font-weight:bold; margin:20px 0 6px 0; page-break-before:auto;"><b>拇指琴演奏家软件V1.0　　第 9 页</b></p>
<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">            eventsEncoded: encoded,
            eventCount: record.events.length,
            appVersion: record.appVersion,
        });
        if (!result?.recordId) throw new Error('missing recordId');
        return result.recordId;
    }

    static async getRecord(recordId: string): Promise&lt;PerformanceRecord&gt; {
        if (!recordId) throw new Error('recordId is required');
        const result = await callWxCloudFunction&lt;GetResult&gt;('getPerformanceRecord', { recordId });
        if (!result?.record) throw new Error('record not found');
        return result.record;
    }
}

// ===== manager/PerformanceShareLaunch.ts =====

import { sys } from 'cc';
import { getWx } from './WeChatNative';

const KEY = 'kalinba_pending_share_record_id_v1';
let installed = false;

function savePendingRecordId(recordId: string): void {
    if (!recordId) return;
    try {
        sys.localStorage.setItem(KEY, recordId);
    } catch {
        // ignore
    }
}

function parseQueryFromOptions(options: unknown): void {
    const query = (options as { query?: Record&lt;string, unknown&gt; } | undefined)?.query;
    const rid = typeof query?.rid === 'string' ? query.rid : '';
    if (rid) {
        savePendingRecordId(rid);
    }
}

export function installShareLaunchCapture(): void {
    if (installed) return;
    installed = true;
    const wxApi = getWx() as {
        cloud?: {
            init?: (arg?: { env?: string; traceUser?: boolean }) =&gt; void;
        };
        getLaunchOptionsSync?: () =&gt; unknown;
        getEnterOptionsSync?: () =&gt; unknown;</pre>
<hr style="border:none; border-top:1px solid #ccc; margin:16px 0;">
<p style="font-size:11pt; font-weight:bold; margin:20px 0 6px 0; page-break-before:auto;"><b>拇指琴演奏家软件V1.0　　第 10 页</b></p>
<pre style="font-family:Consolas,'Courier New',monospace; font-size:9pt; line-height:1.3; background:#fafafa; border:1px solid #ddd; padding:6px 10px; page-break-inside:auto; white-space:pre-wrap; word-wrap:break-word;">        onShow?: (cb: (opt: unknown) =&gt; void) =&gt; void;
    } | undefined;
    if (!wxApi) return;
    try {
        wxApi.cloud?.init?.({ traceUser: true });
    } catch {
        // ignore
    }
    try {
        if (wxApi.getLaunchOptionsSync) parseQueryFromOptions(wxApi.getLaunchOptionsSync());
        if (wxApi.getEnterOptionsSync) parseQueryFromOptions(wxApi.getEnterOptionsSync());
    } catch {
        // ignore
    }
    try {
        wxApi.onShow?.((opt) =&gt; parseQueryFromOptions(opt));
    } catch {
        // ignore
    }
}

export function takePendingSharedRecordId(): string {
    try {
        const rid = sys.localStorage.getItem(KEY) ?? '';
        if (rid) sys.localStorage.removeItem(KEY);
        return rid;
    } catch {
        return '';
    }
}

